{
  "name": "@agent-comms/landing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prune-next-runtime.mjs",
    "check": "tsc --noEmit && npm run build",
