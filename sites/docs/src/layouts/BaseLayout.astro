---
import Header from "@components/Header.astro";
import SearchDialog from "@components/SearchDialog.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  image?: string;
};

// RFC 0021: each page gets its own generated OG image (src/pages/og/
// [...slug].png.ts) rather than sharing the one static social-card.svg --
// derived from the URL, matching that route's own [...slug] param, so
// individual pages don't need to pass `image` explicitly. The homepage's
// empty pathname maps to the route's "home" slug.
const defaultImage = `/og/${Astro.url.pathname.replace(/^\/|\/$/g, "") || "home"}.png`;
const { title, description, image = defaultImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Agent Comms",
  url: Astro.site?.toString(),
  logo: new URL("/icon-512.png", Astro.site).toString(),
  sameAs: ["https://github.com/DhanushSantosh/AgentComms"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1419" />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/commit-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
    <script is:inline>
      const savedTheme = localStorage.getItem("agent-comms-docs-theme");
      const preferredTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = savedTheme || preferredTheme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <SearchDialog />
    <script>
      for (const block of document.querySelectorAll<HTMLElement>(".prose pre")) {
        if (block.querySelector(".code-copy")) continue;
        const button = document.createElement("button");
        button.className = "code-copy";
        button.type = "button";
        button.textContent = "Copy";
        button.setAttribute("aria-label", "Copy code block");
        button.addEventListener("click", async () => {
          const code = block.querySelector("code")?.textContent ?? "";
          await navigator.clipboard.writeText(code);
          button.textContent = "Copied";
          window.setTimeout(() => { button.textContent = "Copy"; }, 1400);
        });
        block.append(button);
      }
    </script>
  </body>
</html>
