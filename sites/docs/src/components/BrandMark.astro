---
const { compact = false } = Astro.props;
---

<a class:list={["brand", { "brand--compact": compact }]} href="/" aria-label="Agent Comms documentation home">
  <svg class="brand__mark" viewBox="0 0 36 36" aria-hidden="true">
    <path d="M7 10.5h14.5a7.5 7.5 0 0 1 0 15H15" />
    <path d="M15 18h14M7 25.5V18h8" />
    <circle cx="7" cy="10.5" r="2.5" />
    <circle cx="7" cy="25.5" r="2.5" />
    <circle cx="29" cy="18" r="2.5" />
  </svg>
  <span class="brand__name">Agent Comms</span>
  <span class="brand__division">Docs</span>
</a>

<style>
  .brand {
    align-items: center;
    color: var(--ink);
    display: inline-flex;
    gap: 0.65rem;
    min-width: max-content;
    text-decoration: none;
  }

  .brand__mark {
    fill: none;
    height: 2rem;
    overflow: visible;
    stroke: var(--signal);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 2rem;
  }

  .brand__mark circle {
    fill: var(--canvas);
  }

  .brand__name {
    font-size: 0.98rem;
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  .brand__division {
    border-left: 1px solid var(--line-strong);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    padding-left: 0.65rem;
    text-transform: uppercase;
  }

  @media (max-width: 29rem) {
    .brand__division,
    .brand--compact .brand__name {
      display: none;
    }
  }
</style>
