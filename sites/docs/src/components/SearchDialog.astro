---
import { flatNavigation } from "@data/navigation";
---

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-dialog__head">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
    <label class="sr-only" id="search-title" for="docs-search">Search Agent Comms documentation</label>
    <input id="docs-search" type="search" autocomplete="off" placeholder="Search commands, concepts, and workflows" data-search-input />
    <button type="button" data-search-close aria-label="Close search">Esc</button>
  </div>
  <div class="search-dialog__status" data-search-status>Start typing to search the manual.</div>
  <ol class="search-results" data-search-results></ol>
</dialog>

<script is:inline define:vars={{ fallbackItems: flatNavigation }}>
  const dialog = document.querySelector("[data-search-dialog]");
  const input = document.querySelector("[data-search-input]");
  const results = document.querySelector("[data-search-results]");
  const status = document.querySelector("[data-search-status]");
  let pagefind;

  const escapeHTML = (value) => value.replace(/[&<>'"]/g, (character) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;"
  })[character]);

  const openSearch = async () => {
    dialog.showModal();
    input.focus();
    if (!pagefind) {
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.init();
      } catch {
        pagefind = null;
      }
    }
  };

  const render = (items) => {
    results.innerHTML = items.map((item) => `
      <li><a href="${item.url}"><span>${escapeHTML(item.title)}</span>${item.excerpt ? `<small>${item.excerpt}</small>` : ""}</a></li>
    `).join("");
    status.textContent = items.length ? `${items.length} result${items.length === 1 ? "" : "s"}` : "No matching pages. Try a command or protocol state.";
  };

  input.addEventListener("input", async () => {
    const query = input.value.trim();
    if (!query) {
      results.innerHTML = "";
      status.textContent = "Start typing to search the manual.";
      return;
    }
    if (pagefind) {
      const search = await pagefind.search(query);
      const data = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
      render(data.map((item) => ({ title: item.meta.title, url: item.url, excerpt: item.excerpt })));
      return;
    }
    const normalized = query.toLowerCase();
    render(fallbackItems.filter((item) => item.title.toLowerCase().includes(normalized)).slice(0, 8).map((item) => ({ title: item.title, url: item.href })));
  });

  document.querySelectorAll("[data-search-trigger]").forEach((button) => button.addEventListener("click", openSearch));
  document.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
  });
</script>

<style is:global>
  .search-dialog {
    background: var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: 0.55rem;
    box-shadow: var(--shadow-large);
    color: var(--ink);
    margin: 12vh auto 0;
    max-height: min(38rem, 76vh);
    padding: 0;
    width: min(42rem, calc(100vw - 2rem));
  }

  .search-dialog::backdrop {
    background: rgba(4, 12, 16, 0.62);
    backdrop-filter: blur(4px);
  }

  .search-dialog__head {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 0.75rem;
    padding: 0.8rem;
  }

  .search-dialog__head svg {
    fill: none;
    height: 1.15rem;
    stroke: var(--signal-strong);
    stroke-width: 1.7;
    width: 1.15rem;
  }

  input {
    background: transparent;
    border: 0;
    color: var(--ink);
    flex: 1;
    font: inherit;
    font-size: 1rem;
    min-width: 0;
    outline: 0;
  }

  input::placeholder {
    color: var(--steel);
  }

  button {
    background: var(--surface-muted);
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.28rem 0.4rem;
  }

  .search-dialog__status {
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    padding: 0.7rem 1rem 0.35rem;
    text-transform: uppercase;
  }

  .search-results {
    list-style: none;
    margin: 0;
    max-height: 28rem;
    overflow-y: auto;
    padding: 0.35rem 0.6rem 0.8rem;
  }

  .search-results a {
    border-bottom: 1px solid var(--line);
    border-radius: 0.35rem;
    color: var(--ink);
    display: grid;
    gap: 0.15rem;
    padding: 0.68rem 0.75rem;
    text-decoration: none;
  }

  .search-results a:hover,
  .search-results a:focus-visible {
    background: var(--signal-soft);
  }

  .search-results span {
    font-size: 0.86rem;
    font-weight: 650;
  }

  .search-results small {
    color: var(--muted);
    display: -webkit-box;
    font-size: 0.73rem;
    line-height: 1.45;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .search-results mark {
    background: var(--warning-soft);
    color: var(--ink);
    padding: 0 0.08em;
  }
</style>
