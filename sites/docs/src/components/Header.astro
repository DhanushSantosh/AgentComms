---
import BrandMark from "./BrandMark.astro";
import { product } from "@data/product";
---

<header class="site-header">
  <div class="site-header__brand">
    <button class="icon-button menu-button" type="button" aria-label="Open documentation navigation" aria-controls="docs-sidebar" aria-expanded="false" data-menu-button>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <BrandMark compact />
  </div>

  <div class="site-header__actions">
    <a class="product-link" href={product.marketingSite} aria-label="Agent Comms product website">
      <span>Product</span><i aria-hidden="true">↗</i>
    </a>

    <span class="channel" title="Documentation channel">
      <span class="channel__signal"></span>
      <span>{product.channel}</span>
      <span class="channel__version">v{product.version}</span>
    </span>

    <button class="search-trigger" type="button" data-search-trigger aria-haspopup="dialog" aria-label="Search documentation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      <span>Search the manual</span>
      <kbd>⌘ K</kbd>
    </button>

    <a class="icon-button" href={product.repository} aria-label="Agent Comms on GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.3 9.3 0 0 0-3 18.1c.5.1.6-.2.6-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.3-2.3-.3-4.6-1.1-4.6-5A3.9 3.9 0 0 1 7 8.1c-.1-.3-.5-1.3.1-2.7 0 0 .8-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.8-4.6 5 .4.3.7 1 .7 1.9v2.7c0 .3.2.6.7.5A9.3 9.3 0 0 0 12 2.8Z" /></svg>
    </a>

    <button class="icon-button" type="button" aria-label="Toggle color theme" data-theme-button>
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8 8 0 0 1 8.8 3.6 8.4 8.4 0 1 0 20.4 15.2Z" /></svg>
    </button>
  </div>
</header>

<script is:inline>
  const menuButton = document.querySelector("[data-menu-button]");
  const setMenu = (open) => {
    document.documentElement.classList.toggle("nav-open", open);
    menuButton?.setAttribute("aria-expanded", String(open));
  };
  menuButton?.addEventListener("click", () => setMenu(!document.documentElement.classList.contains("nav-open")));
  document.querySelector("[data-sidebar-scrim]")?.addEventListener("click", () => setMenu(false));

  document.querySelector("[data-theme-button]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("agent-comms-docs-theme", next);
  });
</script>

<style>
  .site-header {
    align-items: center;
    background: color-mix(in srgb, var(--chrome) 94%, transparent);
    border-bottom: 1px solid var(--chrome-line);
    display: flex;
    height: var(--header-height);
    justify-content: space-between;
    padding: 0 1.2rem 0 1.45rem;
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px);
  }

  .site-header__brand,
  .site-header__actions {
    align-items: center;
    display: flex;
    gap: 0.7rem;
  }

  .icon-button,
  .search-trigger,
  .product-link {
    align-items: center;
    background: transparent;
    border: 1px solid transparent;
    color: color-mix(in srgb, #ffffff 78%, transparent);
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
  }

  .icon-button {
    border-color: color-mix(in srgb, #ffffff 38%, transparent);
    border-radius: 0;
    height: 2.25rem;
    width: 2.25rem;
  }

  .icon-button:hover,
  .search-trigger:hover,
  .product-link:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--chrome);
  }

  .icon-button svg,
  .search-trigger svg {
    fill: none;
    height: 1.1rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    width: 1.1rem;
  }

  .icon-button[href] svg {
    fill: currentColor;
    stroke: none;
  }

  .search-trigger {
    background: color-mix(in srgb, var(--chrome) 38%, transparent);
    border-color: color-mix(in srgb, #ffffff 40%, transparent);
    border-radius: 0;
    gap: 0.55rem;
    height: 2.25rem;
    justify-content: flex-start;
    min-width: 15.5rem;
    padding: 0 0.55rem 0 0.7rem;
  }

  .product-link {
    border-color: color-mix(in srgb, #ffffff 38%, transparent);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    gap: 0.45rem;
    height: 2.25rem;
    letter-spacing: 0.04em;
    padding: 0 0.7rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .product-link i {
    color: var(--signal);
    font-style: normal;
  }

  .search-trigger span {
    flex: 1;
    font-size: 0.8rem;
    text-align: left;
  }

  .search-trigger kbd {
    background: var(--chrome);
    border: 1px solid var(--chrome-line);
    border-radius: 0;
    color: var(--chrome-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.16rem 0.32rem;
  }

  .channel {
    align-items: center;
    color: color-mix(in srgb, #ffffff 82%, transparent);
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    gap: 0.42rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .channel__signal {
    background: var(--signal);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--signal-soft);
    height: 0.38rem;
    width: 0.38rem;
  }

  .channel__version {
    color: color-mix(in srgb, #ffffff 58%, transparent);
  }

  .menu-button {
    display: none;
  }

  .theme-icon--moon {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon--moon {
    display: block;
  }

  :global(html[data-theme="dark"]) .theme-icon--sun {
    display: none;
  }

  @media (max-width: 70rem) {
    .menu-button {
      display: inline-flex;
    }
  }

  @media (max-width: 48rem) {
    .channel,
    .search-trigger span,
    .search-trigger kbd {
      display: none;
    }

    .search-trigger {
      justify-content: center;
      min-width: 2.25rem;
      padding: 0;
      width: 2.25rem;
    }

    .product-link span {
      display: none;
    }

    .product-link {
      padding: 0;
      width: 2.25rem;
    }
  }
</style>
