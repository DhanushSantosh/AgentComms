<slot />

<script>
  const rows = [...document.querySelectorAll<HTMLDetailsElement>("details.release-row")];
  // Old panel links used #release-v0-8-2; current links use the heading ID.
  function findTarget(id: string) {
    const legacy = id.match(/^release-(v\d+-\d+-\d+(?:-[\w-]+)?)$/);
    if (legacy) {
      const version = legacy[1].replace(/^(v\d+)-(\d+)-(\d+)/, "$1.$2.$3");
      return document.querySelector<HTMLElement>(`[data-release-panel="${CSS.escape(version)}"]`);
    }
    return document.getElementById(id);
  }
  function restoreAnchor() {
    let id;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    if (!id) return;
    const target = findTarget(id);
    const row = target?.closest<HTMLDetailsElement>("details.release-row");
    if (row) {
      row.open = true;
      row.scrollIntoView({ block: "start" });
    }
  }
  rows.forEach((row) => row.addEventListener("toggle", () => {
    if (!row.open) return;
    const id = row.querySelector(".release-title")?.id;
    if (id) history.replaceState(null, "", `#${id}`);
  }));
  window.addEventListener("hashchange", restoreAnchor);
  restoreAnchor();
</script>

