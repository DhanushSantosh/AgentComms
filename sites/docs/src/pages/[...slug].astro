---
import { getCollection, render } from "astro:content";
import DocsLayout from "@layouts/DocsLayout.astro";
import CommandReference from "@components/CommandReference.astro";
import MCPReference from "@components/MCPReference.astro";
import ReleaseBrowser from "@components/ReleaseBrowser.astro";
import reference from "../generated/reference.json";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// The changelog's per-release headings live inside the release browser; the
// table of contents links to the current release and the archive instead.
const releaseHeadings = [
  ...(headings.some((heading) => heading.depth === 2 && heading.text.startsWith("v")) ? [{ depth: 2, slug: "current-release", text: "Current release" }] : []),
  ...headings.filter((heading) => !heading.text.startsWith("v"))
];
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  audience={entry.data.audience}
  lastVerified={entry.data.lastVerified}
  slug={entry.id}
  headings={entry.id === "releases/changelog" ? releaseHeadings : headings}
  related={entry.data.related}
>
  {entry.id === "releases/changelog" ? <ReleaseBrowser><Content /></ReleaseBrowser> : <Content />}
  {entry.data.template === "cli-reference" && <CommandReference commands={reference.commands} />}
  {entry.data.template === "mcp-reference" && <MCPReference tools={reference.mcp_tools} />}
</DocsLayout>
