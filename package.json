{
  "name": "agent-comms-workspace",
  "private": true,
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "docs:dev": "npm run dev --workspace @agent-comms/docs",
    "docs:build": "npm run build --workspace @agent-comms/docs",
    "docs:check": "npm run check --workspace @agent-comms/docs",
    "docs:generate": "go run ./cmd/agent-comms-docgen",
    "docs:generate:check": "go run ./cmd/agent-comms-docgen --check",
    "docs:test": "npm run test:e2e --workspace @agent-comms/docs",
    "docs:lighthouse": "npm run lighthouse --workspace @agent-comms/docs"
  }
}
